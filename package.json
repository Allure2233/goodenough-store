{
  "name": "goodenough-store",
  "version": "1.0.0",
  "description": "古德因纳夫商城 - 现代化电商平台",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "node server/static-server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "node server/utils/seed.js",
    "test": "node --test",
    "lint": "eslint server/",
    "format": "prettier --write \"server/**/*.js\""
  },
  "keywords": [
    "ecommerce",
    "shopping",
    "nodejs",
    "express",
    "postgresql"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "pg-mem": "^3.0.14"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
