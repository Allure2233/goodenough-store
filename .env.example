# 环境变量配置
NODE_ENV=development
PORT=3000

# PostgreSQL配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goodenough
PGSSL=false
PGPOOL_MAX=10

# JWT配置
JWT_SECRET=goodenough_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# 前端URL（用于CORS）
CLIENT_URL=http://localhost:8080

# DeepSeek AI API配置
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
